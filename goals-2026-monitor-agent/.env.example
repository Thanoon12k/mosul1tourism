# Copy to .env (never commit .env)
BOT_TOKEN=123456:your-telegram-bot-token
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=openai/gpt-oss-120b

# Goals 2026 MCP server (Streamable HTTP endpoint + bearer token)
GOALS_MCP_URL=https://Goals2026.pythonanywhere.com/mcp
GOALS_MCP_TOKEN=your-goals-2026-token

# Your Telegram chat id(s); message the bot once and it replies with yours
ALLOWED_CHAT_IDS=123456789

TZ_OFFSET_HOURS=3
DIGEST_HOUR=9
MONITOR_INTERVAL_MIN=15
DEADLINE_ALERT_DAYS=3
